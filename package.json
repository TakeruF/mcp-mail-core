    "start": "node dist/cli.js",
    "enroll:gmail": "node dist/enroll-gmail.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "overrides": {
    "jose": "6.2.9"
  }
}
