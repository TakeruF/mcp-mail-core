{
  "name": "mcp-mail-core",
  "version": "0.3.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'tests/live/**'",
    "test:live": "vitest run tests/live",
    "test:package": "node scripts/test-package.mjs",
    "start": "node dist/cli.js",
    "enroll:gmail": "node dist/enroll-gmail.js",
    "accounts:list": "node dist/list-accounts.js",
    "accounts:check": "node dist/check-accounts.js",
    "remove:gmail": "node dist/remove-gmail.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "jose": "6.2.9"
  }
}
